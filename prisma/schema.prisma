generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id   String @id
  name String
  // TODO(DB): 残りのフィールドを定義しましょう
  // ここにフィールドの定義を追加します
}

model CartItem {
  id        String @id @default(cuid())
  userId    String
  productId String
  quantity  Int

  @@unique([userId, productId])
}

model Favorite {
  id        String @id @default(cuid())
  userId    String
  productId String

  @@unique([userId, productId])
}
